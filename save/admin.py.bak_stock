from aiogram import Bot, Router
from aiogram.filters import Command
from aiogram.types import CallbackQuery, Message
from sqlalchemy import select

from database.database import AsyncSessionLocal
from database.models import Order, OrderItem, User

from bot.keyboards.admin import (
    admin_orders_keyboard,
    admin_order_detail_keyboard,
)


router = Router()

ADMIN_TELEGRAM_ID = 8727592009


def is_admin(telegram_id: int) -> bool:
    return telegram_id == ADMIN_TELEGRAM_ID


STATUS_LABELS = {
    "PENDING": "🟡 EN ATTENTE",
    "CONFIRMED": "🟢 CONFIRMÉE",
    "PREPARING": "🔵 EN PRÉPARATION",
    "READY": "🟢 PRÊTE",
    "COMPLETED": "✅ TERMINÉE",
    "CANCELLED": "🔴 ANNULÉE",
}


STATUS_MESSAGES = {
    "CONFIRMED": """
🟢 <b>COMMANDE CONFIRMÉE</b>

Votre commande <b>#{order_id}</b> a été confirmée par la boutique.

💰 Total : <b>{total:.2f} €</b>

Nous allons maintenant préparer votre commande.
""",

    "PREPARING": """
🔵 <b>COMMANDE EN PRÉPARATION</b>

Votre commande <b>#{order_id}</b> est maintenant en préparation.

💰 Total : <b>{total:.2f} €</b>

Merci pour votre patience ! 📦
""",

    "READY": """
🟢 <b>COMMANDE PRÊTE</b>

Votre commande <b>#{order_id}</b> est prête ! 🎉

💰 Total : <b>{total:.2f} €</b>

📍 Vous pouvez venir la retirer directement en boutique.

💵 Paiement : <b>liquide sur place</b>
""",

    "COMPLETED": """
✅ <b>COMMANDE TERMINÉE</b>

Votre commande <b>#{order_id}</b> est maintenant terminée.

💰 Total : <b>{total:.2f} €</b>

Merci pour votre commande ! 🛍️
""",

    "CANCELLED": """
🔴 <b>COMMANDE ANNULÉE</b>

Votre commande <b>#{order_id}</b> a été annulée par la boutique.

💰 Montant de la commande : <b>{total:.2f} €</b>

Pour toute question, contactez le support.
""",
}


async def get_orders():
    async with AsyncSessionLocal() as session:
        result = await session.execute(
            select(Order)
            .order_by(Order.created_at.desc())
        )

        return result.scalars().all()


async def show_admin_orders(target):
    orders = await get_orders()

    if not orders:
        text = """
👨‍💼 <b>ADMINISTRATION</b>

📦 Aucune commande.
"""
    else:
        pending = sum(
            1 for order in orders
            if order.status == "PENDING"
        )

        confirmed = sum(
            1 for order in orders
            if order.status == "CONFIRMED"
        )

        preparing = sum(
            1 for order in orders
            if order.status == "PREPARING"
        )

        ready = sum(
            1 for order in orders
            if order.status == "READY"
        )

        text = f"""
👨‍💼 <b>ADMINISTRATION</b>

📦 Commandes : <b>{len(orders)}</b>

🟡 En attente : <b>{pending}</b>
🟢 Confirmées : <b>{confirmed}</b>
🔵 En préparation : <b>{preparing}</b>
🟢 Prêtes : <b>{ready}</b>

Sélectionne une commande :
"""

    keyboard = admin_orders_keyboard(orders)

    if isinstance(target, Message):
        await target.answer(
            text,
            reply_markup=keyboard,
        )
    else:
        await target.message.edit_text(
            text,
            reply_markup=keyboard,
        )


@router.message(Command("admin"))
async def admin_command(message: Message):
    if not is_admin(message.from_user.id):
        await message.answer(
            "⛔ Accès administrateur refusé."
        )
        return

    await show_admin_orders(message)


@router.callback_query(
    lambda callback: callback.data == "admin_orders"
)
async def admin_orders_callback(callback: CallbackQuery):
    if not is_admin(callback.from_user.id):
        await callback.answer(
            "⛔ Accès refusé.",
            show_alert=True,
        )
        return

    await callback.answer()
    await show_admin_orders(callback)


@router.callback_query(
    lambda callback: callback.data.startswith("admin_order:")
)
async def admin_order_detail(callback: CallbackQuery):
    if not is_admin(callback.from_user.id):
        await callback.answer(
            "⛔ Accès refusé.",
            show_alert=True,
        )
        return

    order_id = int(callback.data.split(":")[1])

    async with AsyncSessionLocal() as session:
        order = await session.scalar(
            select(Order).where(
                Order.id == order_id
            )
        )

        if order is None:
            await callback.answer(
                "Commande introuvable.",
                show_alert=True,
            )
            return

        result = await session.execute(
            select(OrderItem)
            .where(OrderItem.order_id == order.id)
            .order_by(OrderItem.id)
        )

        items = result.scalars().all()

    status_text = STATUS_LABELS.get(
        order.status,
        order.status,
    )

    lines = [
        f"👨‍💼 <b>COMMANDE #{order.id}</b>",
        "",
        f"📅 {order.created_at:%d/%m/%Y %H:%M}",
        f"📌 Statut : <b>{status_text}</b>",
        f"💰 Total : <b>{order.total:.2f} €</b>",
        f"💵 Paiement : <b>{order.payment_method}</b>",
        "",
        "📦 <b>ARTICLES</b>",
        "",
    ]

    for item in items:
        lines.append(
            f"• {item.product_name} "
            f"x{item.quantity} "
            f"= <b>{item.subtotal:.2f} €</b>"
        )

    await callback.answer()

    await callback.message.edit_text(
        "\n".join(lines),
        reply_markup=admin_order_detail_keyboard(order),
    )


@router.callback_query(
    lambda callback: callback.data.startswith("admin_status:")
)
async def admin_change_status(callback: CallbackQuery):
    if not is_admin(callback.from_user.id):
        await callback.answer(
            "⛔ Accès refusé.",
            show_alert=True,
        )
        return

    parts = callback.data.split(":")

    order_id = int(parts[1])
    new_status = parts[2]

    allowed = {
        "PENDING": {"PREPARING", "CANCELLED"},
        "PREPARING": {"READY", "CANCELLED"},
        "READY": {"COMPLETED"},
    }

    async with AsyncSessionLocal() as session:
        order = await session.scalar(
            select(Order).where(
                Order.id == order_id
            )
        )

        if order is None:
            await callback.answer(
                "Commande introuvable.",
                show_alert=True,
            )
            return

        current_status = order.status

        if new_status not in allowed.get(
            current_status,
            set(),
        ):
            await callback.answer(
                f"Transition impossible : "
                f"{current_status} → {new_status}",
                show_alert=True,
            )
            return

        # Récupération du client
        user = await session.scalar(
            select(User).where(
                User.id == order.user_id
            )
        )

        if user is None:
            await callback.answer(
                "Utilisateur introuvable.",
                show_alert=True,
            )
            return

        telegram_id = user.telegram_id
        total = order.total

        # Modification du statut
        order.status = new_status

        await session.commit()

    # Confirmation côté administrateur
    await callback.answer(
        f"✅ Commande #{order_id} : "
        f"{STATUS_LABELS.get(new_status, new_status)}"
    )

    # Notification client
    bot: Bot = callback.bot

    notification_template = STATUS_MESSAGES.get(new_status)

    if notification_template:
        notification = notification_template.format(
            order_id=order_id,
            total=total,
        )

        try:
            await bot.send_message(
                chat_id=telegram_id,
                text=notification,
            )

        except Exception as error:
            print(
                f"⚠️ Impossible d'envoyer la notification "
                f"pour la commande #{order_id} : {error}"
            )

    # Rafraîchir la commande dans l'administration
    await admin_order_detail(callback)
