from aiogram.fsm.state import State, StatesGroup


class ProductStates(StatesGroup):
    waiting_name = State()
    waiting_description = State()
    waiting_price = State()
    waiting_stock = State()
    waiting_category = State()


class CategoryStates(StatesGroup):
    waiting_name = State()
    waiting_description = State()
    waiting_sort_order = State()
